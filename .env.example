# Supabase 프로젝트 설정의 프로젝트 URL과 공개용 publishable key를 입력하세요.
# secret key 또는 service_role 키를 NEXT_PUBLIC_ 변수에 넣지 마세요.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버에서만 사용하는 기존 OpenAI API 키입니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# 공용 작문 문제와 채점 결과의 서버 전용 쓰기 증명입니다. 공개 변수로 만들지 마세요.
# scripts/configure-writing.mjs가 로컬 값을 생성하고 DB 등록용 SHA-256 해시만 출력합니다.
WRITING_SERVER_SECRET=
